# Copy to .env and fill in. Never commit .env.
APP_ENV=dev                      # dev | test | prod  (prod refuses to start without secrets)
LOG_LEVEL=INFO

# MongoDB. docker-compose overrides this with mongodb://mongo:27017.
# Use mongomock:// for a throw-away in-memory database (no MongoDB needed; data lost on restart).
MONGO_URL=mongodb://localhost:27017
MONGO_DB=scheme_finder

# Secrets - generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
STORAGE_SECRET=change-me

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_FAILURES=5
LOCKOUT_MINUTES=15
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=300
CORS_ORIGINS=http://localhost:8080

# Create the demo accounts and 30 schemes automatically when the database is empty
SEED_ON_STARTUP=true

# Encryption key for uploaded files (kept outside the database). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me
FILE_STORAGE_DIR=storage/documents
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=10
# TESSERACT_CMD=/usr/bin/tesseract   # only if tesseract is not on PATH (Windows: full path to tesseract.exe)

# LLM: "mock" needs no key. "anthropic" needs requirements-ai.txt and an API key.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5

# Retrieval for the assistant. auto = multilingual-e5-small if installed, else the hash fallback.
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=intfloat/multilingual-e5-small
VECTOR_BACKEND=chroma
CHROMA_DIR=storage/chroma
ASSISTANT_MIN_CONFIDENCE=0.6

# Voice input (speech-to-text with faster-whisper; needs requirements-ai.txt). Read-aloud uses the browser.
ENABLE_VOICE=false
WHISPER_MODEL=small        # tiny | base | small (better Hindi) | medium
